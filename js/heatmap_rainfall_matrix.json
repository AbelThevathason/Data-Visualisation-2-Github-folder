{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "purpose": "Visualizes annual historical rainfall anomalies (mm) by Australian State and Territory (2000–2024) to track regional drought and wet cycles.",
    "chartType": "Matrix Heatmap (Diverging Color Scale)",
    "dataRequirements": "Requires 'Year', 'State', and 'Rainfall_Anomaly_mm' fields in australia_rainfall_anomalies_2000_2024.csv."
  },
  "width": 800,
  "height": 320,
  "title": {
    "text": "25-Year Australian Historical Rainfall Anomaly Matrix (2000–2024)",
    "subtitle": "Annual deviation from long-term baseline rainfall (mm) by State/Territory",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "data": {
    "_comment": "Loads 25-year regional rainfall anomaly dataset",
    "url": "Researched Data/Processed Data/australia_rainfall_anomalies_2000_2024.csv"
  },
  "description": "Matrix heatmap showing annual state-by-state rainfall anomalies (mm) using a red-blue diverging color scale centered at 0.",
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 1.5,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": -45,
        "titlePadding": 10
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": "State / Territory",
      "axis": {
        "titlePadding": 10
      }
    },
    "color": {
      "field": "Rainfall_Anomaly_mm",
      "type": "quantitative",
      "title": "Anomaly (mm)",
      "scale": {
        "scheme": "redblue",
        "domainMid": 0
      }
    },
    "tooltip": [
      {"field": "State", "type": "nominal", "title": "State / Territory"},
      {"field": "Year", "type": "ordinal", "title": "Year"},
      {
        "field": "Rainfall_Anomaly_mm", 
        "type": "quantitative", 
        "title": "Rainfall Anomaly (mm)", 
        "format": ".2f"
      }
    ]
  },
  "config": {
    "axis": {
      "grid": false
    },
    "view": {
      "stroke": null
    }
  }
}