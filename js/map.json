{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Australian Broadacre Farm Performance",
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "data/aus_regions.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_50m_admin_1_states_provinces"
    }
  },
  "transform": [
    {
      "lookup": "properties.NAME",
      "from": {
        "data": {
          "url": "Researched Data/farm_data.csv"
        },
        "key": "Region",
        "fields": ["Rate of return (%)"]
      }
    }
  ],
  "mark":{ 
    "type":"geoshape",
    "stroke":"#ffffff"
  },
  "encoding": {
    "color": {
      "field": "Rate of return (%)",
      "type": "quantitative"
    },
    "tooltip": [
      {"field": "properties.NAME", "type": "nominal", "title": "State/Region"},
      {"field": "Rate of return (%)", "type": "quantitative"}
    ]
  }
}