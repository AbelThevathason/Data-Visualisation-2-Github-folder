{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Australian Broadacre Grain Performance (2000–2024)",
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "Researched Data/grains_state_yearly.csv"
  },
  "params": [
    {
      "name": "YearSelect",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2024,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.Year == YearSelect"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "url": "Map_of_Australia.json",
          "format": {
            "type": "topojson",
            "feature": "ne_50m_admin_1_states_provinces"
          }
        },
        "key": "properties.name"
      },
      "as": "geo"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff"
  },
  "encoding": {
    "shape": {
      "field": "geo",
      "type": "geojson"
    },
    "color": {
      "field": "Rate_of_return",
      "type": "quantitative",
      "title": "Rate of Return (%)",
      "scale": {
        "scheme": "redyellowgreen",
        "domain": [-3, 7]
      }
    },
    "tooltip": [
      {"field": "State", "type": "nominal"},
      {"field": "Region", "type": "nominal", "title": "GRDC Region"},
      {"field": "Year", "type": "quantitative"},
      {"field": "Rate_of_return", "type": "quantitative", "title": "Rate of Return (%)", "format": ".2f"}
    ]
  }
}