{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": {
    "text": "Australia's Agricultural Footprint",
    "subtitle": "Percentage of total land area dedicated to farming & agriculture by State/Territory"
  },
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "Map_of_Australia.json",
    "format": {
      "type": "topojson",
      "feature": "ne_50m_admin_1_states_provinces"
    }
  },
  "params": [
    {
      "name": "PeriodSelect",
      "value": "2020-21",
      "bind": {
        "input": "select",
        "options": ["2010-11", "2015-16", "2020-21"],
        "name": "Select Mapping Period: "
      }
    }
  ],
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "Researched Data/Processed Data/Land use percentage.csv"
        },
        "key": "State",
        "fieldsx": [
          "Pct_Farming_Land",
          "Pct_Grazing",
          "Pct_Cropping",
          "Period",
          "Total_Farming_Area_000_ha"
        ]
      }
    },
    {
      "filter": "datum.Period == PeriodSelect"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#ffffff",
    "strokeWidth": 1.2
  },
  "encoding": {
    "color": {
      "field": "Pct_Farming_Land",
      "type": "quantitative",
      "scale": {
        "scheme": "greens",
        "domain": [10, 85]
      },
      "legend": {
        "title": "Farming Land (%)",
        "format": ".1f"
      }
    },
    "tooltip": [
      {
        "field": "properties.name",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "Pct_Farming_Land",
        "type": "quantitative",
        "title": "Total Farming Land (%)",
        "format": ".1f"
      },
      {
        "field": "Pct_Grazing",
        "type": "quantitative",
        "title": "Grazing Share (%)",
        "format": ".1f"
      },
      {
        "field": "Pct_Cropping",
        "type": "quantitative",
        "title": "Cropping Share (%)",
        "format": ".1f"
      },
      {
        "field": "Period",
        "type": "nominal",
        "title": "Period"
      }
    ]
  }
}