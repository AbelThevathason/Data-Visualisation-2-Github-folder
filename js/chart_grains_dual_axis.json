{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "purpose": "Visualizes dryland cropping rainfall vs. total grains farm business profits (2000–2024) to track climate impacts and financial lag cycles.",
    "chartType": "Dual Y-Axis Time Series Line Chart",
    "dataRequirements": "Requires 'Year', 'Dryland_Cropping_Rainfall_mm', and 'Grains_Profit_Total_Sum_Deciles_AUD' fields."
  },
  "width": 650,
  "height": 380,
  "title": {
    "text": "Grains Sector: Dryland Cropping Rainfall vs. Total Farm Profit (2000–2024)",
    "subtitle": "Dual Y-axis time series with connected points tracking annual climate and financial returns",
    "fontSize": 14,
    "subtitleFontSize": 11
  },
  "data": {
    "_comment": "Loads 25-year time-series CSV data containing cropping rainfall and grains farm profit metrics",
    "url": "Researched Data/Processed Data/dryland_cropping_rainfall_vs_grain_profits_2000_2024.csv"
  },
  "layer": [
    {
      "description": "LAYER 1: Dryland Cropping Rainfall (Left Axis) - Solid blue line with circular point markers (0–700 mm range)",
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 60},
        "color": "#1f77b4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelAngle": -45}
        },
        "y": {
          "field": "Dryland_Cropping_Rainfall_mm",
          "type": "quantitative",
          "axis": {
            "title": "Dryland Cropping Rainfall (mm)",
            "titleColor": "#1f77b4"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {"field": "Dryland_Cropping_Rainfall_mm", "type": "quantitative", "title": "Cropping Rainfall (mm)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "LAYER 2: Total Grains Profit in AUD (Right Axis) - Orange dashed line with diamond point markers (-$500k to $3.5M range)",
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 60, "shape": "diamond"},
        "color": "#ff7f0e",
        "strokeWidth": 2,
        "strokeDash": [4, 3]
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Grains_Profit_Total_Sum_Deciles_AUD",
          "type": "quantitative",
          "axis": {
            "title": "Total Grains Profit ($ AUD)",
            "titleColor": "#ff7f0e",
            "format": "$,.0f"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {"field": "Grains_Profit_Total_Sum_Deciles_AUD", "type": "quantitative", "title": "Total Grains Profit ($)", "format": "$,.0f"}
        ]
      }
    }
  ],
  "resolve": {
    "_comment": "Uncouples Y-axis scales so cropping rainfall (mm) and grains profit ($ AUD) display independently on opposite sides",
    "scale": {"y": "independent"}
  }
}