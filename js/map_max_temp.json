{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "usermeta": {
    "purpose": "Visualizes spatial maximum temperature contour bands (°C) across Australia for 2024 using GeoJSON polygon features and TopoJSON state borders.",
    "chartType": "Spatial Contour Map (Full Vega v5 Specification)",
    "dataRequirements": "Requires Map_of_Australia.json (TopoJSON) and australia_max_temp_bands_2024.geojson."
  },
  "width": 520,
  "height": 420,
  "padding": 10,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Maximum Temperature Contour Map Across Australia (2024)",
    "subtitle": "Data source: SILO / Bureau of Meteorology (AGCD)",
    "fontSize": 13,
    "subtitleFontSize": 10
  },
  "projections": [
    {
      "name": "projection",
      "type": "mercator",
      "fit": {"signal": "data('australia_border')"},
      "size": {"signal": "[width, height]"}
    }
  ],
  "scales": [
    {
      "_comment": "Discretized threshold color scale mapping temperature bands to 6 red color scheme steps",
      "name": "color",
      "type": "threshold",
      "domain": [18, 22, 26, 30, 34],
      "range": {"scheme": "reds", "count": 6}
    }
  ],
  "data": [
    {
      "name": "australia_border",
      "_comment": "TopoJSON state and territory border geometries used for map fitting and boundary outlines",
      "url": "Map_of_Australia.json",
      "format": {
        "type": "topojson",
        "feature": "ne_50m_admin_1_states_provinces"
      }
    },
    {
      "name": "temp_bands",
      "_comment": "GeoJSON polygon bands representing maximum temperature ranges (°C) across Australia",
      "url": "Researched Data/Processed Data/australia_max_temp_bands_2024.geojson",
      "format": {"type": "json", "property": "features"}
    }
  ],
  "marks": [
    {
      "description": "MARK 1: Base background shape filling the Australian landmass with neutral light gray",
      "type": "shape",
      "from": {"data": "australia_border"},
      "encode": {
        "update": {
          "fill": {"value": "#f4f4f4"},
          "stroke": {"value": "#b0b0b0"},
          "strokeWidth": {"value": 0.8}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    },
    {
      "description": "MARK 2: GeoJSON temperature contour bands filled by threshold color scale with hover tooltips",
      "type": "shape",
      "from": {"data": "temp_bands"},
      "encode": {
        "update": {
          "fill": {"scale": "color", "field": "properties.level"},
          "fillOpacity": {"value": 0.9},
          "stroke": {"value": "#800000"},
          "strokeWidth": {"value": 0.4},
          "tooltip": {"signal": "{'Max temp band (°C)': datum.properties.label}"}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    },
    {
      "description": "MARK 3: Overlay border shape drawing crisp administrative state borders above temperature fills",
      "type": "shape",
      "from": {"data": "australia_border"},
      "encode": {
        "update": {
          "fill": {"value": null},
          "stroke": {"value": "#7a7a7a"},
          "strokeWidth": {"value": 0.5}
        }
      },
      "transform": [
        {"type": "geoshape", "projection": "projection"}
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Max Temp Band (°C)",
      "orient": "right",
      "titleFontSize": 10,
      "labelFontSize": 9
    }
  ]
}