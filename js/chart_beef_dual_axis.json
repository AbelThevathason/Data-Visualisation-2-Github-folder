{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "purpose": "Visualizes the temporal co-movement between grazing pasture rainfall and total beef farm profit (2000–2024).",
    "chartType": "Dual Y-Axis Time Series Line Chart",
    "dataRequirements": "Requires 'Year', 'Grazing_Rainfall_mm', and 'Beef_Profit_Total_Deciles_AUD' fields."
  },
  "width": 650,
  "height": 380,
  "title": {
    "text": "Beef Sector: Grazing Pasture Rainfall vs. Total Farm Profit (2000–2024)",
    "subtitle": "Dual Y-axis time series with connected points tracking annual climate and financial returns",
    "fontSize": 14,
    "subtitleFontSize": 11
  },
  "data": {
    "_comment": "Loads 25-year time-series CSV data containing pasture rainfall and beef profit metrics",
    "url": "Researched Data/Processed Data/grazing_rainfall_vs_beef_profit_2000_2024.csv"
  },
  "layer": [
    {
      "description": "LAYER 1: Grazing Pasture Rainfall (Left Axis) - Rendered as a solid blue line with circle markers",
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 60},
        "color": "#1f77b4",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelAngle": -45}
        },
        "y": {
          "field": "Grazing_Rainfall_mm",
          "type": "quantitative",
          "axis": {
            "title": "Grazing Pasture Rainfall (mm)",
            "titleColor": "#1f77b4"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {"field": "Grazing_Rainfall_mm", "type": "quantitative", "title": "Pasture Rainfall (mm)", "format": ".1f"}
        ]
      }
    },
    {
      "description": "LAYER 2: Total Beef Profit in AUD (Right Axis) - Rendered as a green dashed line with square markers",
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 60, "shape": "square"},
        "color": "#2ca02c",
        "strokeWidth": 2,
        "strokeDash": [4, 3]
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Beef_Profit_Total_Deciles_AUD",
          "type": "quantitative",
          "axis": {
            "title": "Total Beef Profit ($ AUD)",
            "titleColor": "#2ca02c",
            "format": "$,.0f"
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal"},
          {"field": "Beef_Profit_Total_Deciles_AUD", "type": "quantitative", "title": "Total Beef Profit ($)", "format": "$,.0f"}
        ]
      }
    }
  ],
  "resolve": {
    "_comment": "Uncouples Y-axis scales so rainfall (mm) and profit ($ AUD) display independently on opposite sides",
    "scale": {"y": "independent"}
  }
}