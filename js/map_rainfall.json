{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Binned Spatial Rainfall Heatmap Across Australia (2000–2024)",
    "subtitle": "Data source: SILO / Bureau of Meteorology (AGCD)",
    "fontSize": 14,
    "subtitleFontSize": 11
  },
  "params": [
    {
      "name": "YearSelect",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2024,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "Map_of_Australia.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f4f4",
        "stroke": "#b0b0b0",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "Researched Data/Processed Data/silo_annual_rainfall_2000_2024_spatial.csv"
      },
      "transform": [
        {
          "filter": "datum.year == YearSelect"
        },
        {
          "bin": {
            "step": 1.0
          },
          "field": "lon",
          "as": ["lon_bin", "lon_bin_end"]
        },
        {
          "bin": {
            "step": 1.0
          },
          "field": "lat",
          "as": ["lat_bin", "lat_bin_end"]
        },
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "annual_rainfall_mm",
              "as": "mean_rainfall"
            }
          ],
          "groupby": ["lon_bin", "lon_bin_end", "lat_bin", "lat_bin_end"]
        },
        {
          "filter": "datum.mean_rainfall > 15 && datum.lon_bin >= 113 && datum.lon_bin <= 153.5 && datum.lat_bin >= -43.5 && datum.lat_bin <= -10.5"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.88
      },
      "encoding": {
        "longitude": {
          "field": "lon_bin",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon_bin_end"
        },
        "latitude": {
          "field": "lat_bin",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "lat_bin_end"
        },
        "color": {
          "field": "mean_rainfall",
          "type": "quantitative",
          "title": "Rainfall Bin (mm)",
          "scale": {
            "type": "threshold",
            "domain": [200, 400, 600, 1000, 1500, 2000],
            "scheme": "teals"
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 10,
            "labelFontSize": 9,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {"field": "lon_bin", "type": "quantitative", "title": "Longitude Min", "format": ".1f"},
          {"field": "lat_bin", "type": "quantitative", "title": "Latitude Min", "format": ".1f"},
          {"field": "mean_rainfall", "type": "quantitative", "title": "Average Rainfall (mm)", "format": ".1f"}
        ]
      }
    }
  ]
}