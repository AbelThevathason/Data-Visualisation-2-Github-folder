{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "purpose": "Visualizes binned spatial rainfall grid heatmaps across Australia (2000–2024) with interactive year slider control.",
    "chartType": "Binned Spatial Heatmap (Mercator Projection with Discretized Threshold Scale)",
    "dataRequirements": "Requires 'year', 'lon', 'lat', and 'annual_rainfall_mm' fields in silo_annual_rainfall_2000_2024_spatial.csv."
  },
  "width": 600,
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "title": {
    "text": "Binned Spatial Rainfall Heatmap Across Australia (2000–2024)",
    "subtitle": "Data source: SILO / Bureau of Meteorology (AGCD)",
    "fontSize": 14,
    "subtitleFontSize": 11
  },
  "params": [
    {
      "name": "YearSelect",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2024,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "description": "LAYER 1: Base TopoJSON landmass map rendering Australian state boundaries",
      "data": {
        "url": "Map_of_Australia.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f4f4",
        "stroke": "#b0b0b0",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "LAYER 2: Spatial 1-degree binned rainfall rectangle cells color-coded by discrete threshold bands",
      "data": {
        "_comment": "Loads 25-year spatial annual rainfall dataset containing SILO/BOM climate coordinates",
        "url": "Researched Data/Processed Data/silo_annual_rainfall_2000_2024_spatial.csv"
      },
      "transform": [
        {
          "_comment": "Step 1: Filter spatial dataset to the year selected on the interactive range slider",
          "filter": "datum.year == YearSelect"
        },
        {
          "_comment": "Step 2: Bin longitude into 1.0-degree spatial step intervals",
          "bin": {
            "step": 1.0
          },
          "field": "lon",
          "as": ["lon_bin", "lon_bin_end"]
        },
        {
          "_comment": "Step 3: Bin latitude into 1.0-degree spatial step intervals",
          "bin": {
            "step": 1.0
          },
          "field": "lat",
          "as": ["lat_bin", "lat_bin_end"]
        },
        {
          "_comment": "Step 4: Compute mean annual rainfall (mm) per 1x1 degree spatial cell",
          "aggregate": [
            {
              "op": "mean",
              "field": "annual_rainfall_mm",
              "as": "mean_rainfall"
            }
          ],
          "groupby": ["lon_bin", "lon_bin_end", "lat_bin", "lat_bin_end"]
        },
        {
          "_comment": "Step 5: Suppress off-shore ocean cells and filter to Australian spatial boundaries",
          "filter": "datum.mean_rainfall > 15 && datum.lon_bin >= 113 && datum.lon_bin <= 153.5 && datum.lat_bin >= -43.5 && datum.lat_bin <= -10.5"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.88
      },
      "encoding": {
        "longitude": {
          "field": "lon_bin",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon_bin_end"
        },
        "latitude": {
          "field": "lat_bin",
          "type": "quantitative"
        },
        "latitude2": {
          "field": "lat_bin_end"
        },
        "color": {
          "field": "mean_rainfall",
          "type": "quantitative",
          "title": "Rainfall Bin (mm)",
          "scale": {
            "type": "threshold",
            "domain": [200, 400, 600, 1000, 1500, 2000],
            "scheme": "teals"
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 10,
            "labelFontSize": 9,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {"field": "lon_bin", "type": "quantitative", "title": "Longitude Min", "format": ".1f"},
          {"field": "lat_bin", "type": "quantitative", "title": "Latitude Min", "format": ".1f"},
          {"field": "mean_rainfall", "type": "quantitative", "title": "Average Rainfall (mm)", "format": ".1f"}
        ]
      }
    }
  ]
}